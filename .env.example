# Copy to .env and fill in. .env is gitignored and never committed.

# ---------- provider ----------
OPENAI_API_KEY=sk-proj-...

# ---------- models ----------
# Reasoning effort is a standard ChatOpenAI parameter (langchain-openai >= 1.4.1)
# and passes through init_chat_model kwargs into the request payload.
MODEL_PROVIDER=openai
MODEL_STRONG=gpt-5.6-sol
MODEL_STRONG_REASONING_EFFORT=medium
MODEL_FAST=gpt-5.6-luna
MODEL_FAST_REASONING_EFFORT=high
EMBEDDING_MODEL=text-embedding-3-large

# ---------- postgres ----------
# Matches docker-compose.yml. Port 5433 to stay clear of a local 5432.
DATABASE_URL=postgresql://apidocs:apidocs@localhost:5433/apidocs

# ---------- langsmith ----------
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_pt_...
LANGSMITH_PROJECT=apidocs-support
